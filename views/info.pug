extends ui_layout

block content
  .ui.text.container(style="margin-top: 2em; margin-bottom: 2em;")
    h1(style="text-align: center;") 欢迎来到小蓝书！
    h3 你可以在这里：
    ul
        li 发布动态！上传已有照片，或用手机拍摄新照片。
        li 回复其他人的动态，参与交流。
        li 点赞其他人的动态，表达你的喜爱。
        li 完善个人资料，填写多少由你决定。
        li 通知铃铛变红时，表示你有新通知，记得查看。
    img.ui.centered.image(src='/public/esl-howto.png')
    h3 看看还有谁在这里
    p 有人回复或点赞你的动态或评论时，我们会通知你。
    .ui.big.green.labeled.icon.button.interest
        i.rocket.icon
        |   继续

    script.
        $('.ui.big.green.labeled.icon.button.interest').on('click', function() {
            $(this).addClass('loading disabled');
            $.post("/account/consent", {
                    _csrf: $('meta[name="csrf-token"]').attr('content')
                }).done(function(json) {
                    if (json["result"] === "success") {
                        window.location.href = '/'
                    }
                });
        });
