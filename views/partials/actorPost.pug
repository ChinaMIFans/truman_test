.ui.fluid.card(postCondition=val.condition, postID=val.id, type='actor', actor_un = val.actor.username, actor_name = val.actor.profile.name, actor_pic = val.actor.profile.picture, data-share-popup=showSharePopup ? 'true' : 'false')
  .content
    .right.floated.time.meta= (user.createdAt.getTime() + val.time)
    a(href='/user/'+val.actor.username)     
      img.ui.avatar.image(src='/public/picture.svg', data-src=cdn+"/profile_pictures/"+val.actor.profile.picture)
      span=val.actor.profile.name
  .content.dimmable(class=val.flagged ? "dimmed": "")
    .ui.dimmer.flag(class=val.flagged ? "active": "")
      .content
        .center
          h2.ui.inverted.icon.header
            i.red.flag.icon
            | 您已举报此帖子
            h3.ui.inverted.header
                span="管理员会进一步审核此帖子，感谢您的反馈。"
          .ui.inverted.unflag.button(tabindex='0')
            i.flag.icon
            |  取消举报
    .img.post.image
      img(src=cdn+"/post_pictures/"+val.picture, loading='lazy', decoding='async', style="max-width:100%; width:100%;")
    .description=val.body
    .myTimer.hidden 0
  .ui.bottom.four.attached.icon.buttons
    .ui.reply.button(tabindex='0')
      i.reply.icon
      |  评论
    .ui.flag.button(tabindex='0')
      i.flag.icon
      |  举报
    .ui.labeled.button(tabindex='0')
      .ui.like.button(class=val.liked? "red": null)
        i.heart.icon
        |  喜欢
      a.ui.basic.red.left.pointing.label.count=val.likes
    .ui.share.button(tabindex=val.shared ? '-1' : '0', class=val.shared ? 'red share-completed' : null, aria-disabled=val.shared ? 'true' : 'false', data-tooltip=val.shared ? '已转发' : '转发')
      i.share.icon
      |  转发
  if showSharePopup
    .ui.mini.modal.share-modal(data-share-delay=shareDelaySeconds, data-share-auto-action=shareAutoAction)
      .header=shareModalTitle
      .content
        .share-prompt(data-base-prompt=sharePrompt, data-countdown-template=shareCountdownTemplate, data-action-text=shareActionText)=sharePrompt + (shareAutoAction !== 'none' ? shareCountdownTemplate.replace('{seconds}', String(shareDelaySeconds)).replace('{action}', shareActionText) : '')
      .actions
        button.ui.primary.share-confirm.button(type='button')=shareConfirmText
        button.ui.button.share-cancel(type='button')=shareCancelText
  if val.comments.length > 0
    .content
      .ui.comments
        each comment in val.comments
          //- Comment is user-made
          if comment.new_comment
            .comment(commentID=comment.commentID)
              a.avatar.image(href='/me')
                if user.profile.picture
                  img(src='/user_avatar/'+user.profile.picture)
                else
                  img(src=user.gravatar(60))
              .content
                a.author(href='/me')=user.profile.name || user.username || user.id
                .metadata
                  span.date=(user.createdAt.getTime() + comment.time)
                  .rating
                    i.heart.icon(class=comment.liked ? "red" : null)
                    span.num=comment.likes+(comment.liked ? 1 : 0)
                    |  个赞
                .text=comment.body
                .actions
                  a.like.comment(class=comment.liked ? "red" : null )=comment.liked ? "取消喜欢" : "喜欢"
          //- Else this is a normal comment from the script
          else
            .comment(commentID=comment.id)
              .content(class=!comment.flagged ? "transition hidden" : "")                           
                .text(style="background-color: black; color: white; padding: 0.2em;") 您已举报此评论，管理员会进一步审核，感谢您的反馈。
                .actions 
                  a.unflag 取消举报
              a.avatar(href='/user/'+comment.actor.username, class=comment.flagged ? "transition hidden" : "")                  
                img(src='/public/picture.svg', data-src=cdn+"/profile_pictures/"+comment.actor.profile.picture)
              .content(class=comment.flagged ? "transition hidden" : "")
                a.author(href='/user/'+comment.actor.username)=comment.actor.profile.name
                .metadata
                  span.date=(user.createdAt.getTime() + comment.time)
                  .rating
                    i.heart.icon(class=comment.liked ? "red" : null)
                    span.num=comment.likes+(comment.liked ? 1 : 0)
                    |  个赞
                .text=comment.body
                .actions
                  a.like.comment(class=comment.liked ? "red" : null )=comment.liked ? "取消喜欢" : "喜欢"
                  a.flag.comment 举报
  .extra.content
    .ui.fluid.left.labeled.right.icon.input
      .ui.label
        if user.profile.picture
          img.ui.avatar.image.small(src='/user_avatar/'+user.profile.picture, name=user.profile.name || user.username || user.id)
        else
          img.ui.avatar.image.small(src=user.gravatar(60), name=user.profile.name || user.username || user.id)            
      .ui.form
        .field 
          textarea.newcomment(type='text', placeholder='写下你的评论' rows='1')
      i.big.send.link.icon
