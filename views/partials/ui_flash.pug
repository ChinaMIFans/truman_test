if messages.errors
  .sixteen.wide.column
    .ui.negative.message
      i.close.icon
      for error in messages.errors
        div= error.msg
if messages.info
  .sixteen.wide.column
    .ui.warning.message
      i.close.icon
      for info in messages.info
        div= info.msg
if messages.success
  .sixteen.wide.column
    .ui.positive.message
      i.close.icon
      for success in messages.success
        div= success.msg
if messages.final
  .sixteen.wide.column
    .ui.icon.info.message
      i.trophy.icon
      .content
        .header
          | 感谢你参与本研究！
        ul.list
          li 本研究已结束，你的账号已停用。
          if messages.final[0].msg
            li 如果你还没有填写结束问卷，请点击
              a(href=messages.final[0].msg) 此处
              | 完成。
