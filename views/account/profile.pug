extends ../ui_layout

block content
  .sixteen.wide.column(style="margin-top: 2em; margin-bottom: 2em;")
    h2(style="text-align: center;") 个人资料

    form.ui.large.form(action='/account/profile', method='POST', enctype='multipart/form-data', id='profile')
      input(type='hidden', name='_csrf', value=_csrf)
      .field
        label(for='email') 邮箱
        input.form-control(type='email', name='email', id='email', value=user.email)
      .field
        label(for='name') 昵称
        input.form-control(type='text', name='name', id='name', value=user.profile.name)
      .field
        label(for='location') 所在地
        input.form-control(type='text', name='location', id='location', value=user.profile.location)
      .field
        label(for='bio') 个人简介
        textarea(rows='2', name='bio', id='bio')=user.profile.bio
      .field.image-upload
        p(style="font-weight: bold; font-size: medium; margin-bottom: 0.2em") 头像
          span(style="font-weight: normal") （点击更换）
        label(for='picinput', style="width: fit-content")
          if user.profile.picture
            img#imgInp.ui.small.image(src='/user_avatar/'+user.profile.picture)
          else
            img#imgInp.ui.small.image(src=user.gravatar(60))
        input#picinput(type='file', accept='image/*', capture='camera', name='picinput')
      button.ui.large.button.disabled(type='submit') 保存资料
    .ui.divider
    h3.ui.header(style="margin-top: 2em;") 修改密码
    form.ui.large.form(action='/account/password', method='POST', id='password')
      input(type='hidden', name='_csrf', value=_csrf)
      .field
        label(for='password') 新密码
        input.form-control(type='password', name='password', id='password', placeholder='请输入新密码', minlength="4", required)
      .field
        label(for='confirmPassword') 确认密码
        input.form-control(type='password', name='confirmPassword', id='confirmPassword', placeholder='请再次输入密码', minlength="4", required)
        span(style="color: green; visibility:hidden")#passwordsMatch  
            i.icon.check 
            | 两次输入的密码一致
      button.ui.large.button.disabled(type='submit') 修改密码

block scripts
  script(src='/public/js/profile.js')
